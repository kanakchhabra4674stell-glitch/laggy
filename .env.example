# PauseAI Configuration

# Backend Settings
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./pauseai.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI & Embedding Providers
# Provide GEMINI_API_KEY to enable Gemini-based generation.
# If omitted or empty, PauseAI automatically activates its high-accuracy evidence extractive fallback engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Embeddings (defaults to lightweight all-MiniLM-L6-v2)
EMBEDDING_MODEL=all-MiniLM-L6-v2
DEVICE=cpu

# Storage
DATA_DIR=./data
UPLOAD_DIR=./data/uploads

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
